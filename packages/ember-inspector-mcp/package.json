{
  "name": "ember-inspector-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server that lets an AI agent debug Ember apps through the Ember Inspector browser extension.",
  "type": "module",
  "bin": {
    "ember-inspector-mcp": "./bin/ember-inspector-mcp.mjs"
  },
  "scripts": {
    "start": "node ./bin/ember-inspector-mcp.mjs",
    "test": "node --test \"tests/*-test.mjs\"",
    "lint": "pnpm \"/^lint:(?!fix$)[^:]+$/\"",
    "lint:fix": "pnpm \"/^lint:[^:]+:fix$/\" && pnpm format",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:format": "prettier --cache --check \"**/*.mjs\"",
    "format": "prettier --cache --write \"**/*.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
